<?xml version="1.0" encoding="utf-8"?>
<!-- SÓ na versão de desenvolvimento: permite HTTP sem TLS para os emuladores locais do
     Firebase, que rodam no PC (10.0.2.2 visto de dentro do emulador Android).
     A versão final (release) não tem este arquivo e só fala HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
