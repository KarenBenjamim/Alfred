<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Estudos: temas em abas, resumo do tema, atividade em destaque e módulos (com os assuntos e seus cronômetros) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/list_bottom_space">

            <!-- Temas (abas) + criar tema -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_segment_group"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    app:tabGravity="start"
                    app:tabIndicator="@drawable/bg_tab_indicator"
                    app:tabIndicatorColor="@null"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorGravity="stretch"
                    app:tabMode="scrollable"
                    app:tabRippleColor="@null"
                    app:tabSelectedTextColor="@android:color/white"
                    app:tabTextColor="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/button_add_topic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/study_topic_add"
                    android:src="@drawable/ic_add"
                    app:tint="@color/highlight" />
            </LinearLayout>

            <!-- Resumo do tema -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_card"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/today_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/study"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="3dp"
                            android:layout_weight="1"
                            android:text="@string/study_today_label"
                            android:textAppearance="@style/TextAppearance.Alfred.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/studied_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Alfred.Body" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/studied_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        app:indicatorColor="@color/study" />

                    <TextView
                        android:id="@+id/topic_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Alfred.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Atividade em destaque: o assunto rodando, ou o último estudado -->
            <TextView
                android:id="@+id/focus_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="18dp"
                android:textAppearance="@style/TextAppearance.Alfred.Section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/focus_card"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="8dp"
                app:strokeColor="@color/study_focus_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile"
                        android:backgroundTint="@color/gold_container">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_study"
                            app:tint="@color/study" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/focus_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Alfred.Title" />

                        <TextView
                            android:id="@+id/focus_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Alfred.Caption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/focus_button"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:backgroundTint="@color/highlight"
                        app:iconSize="26dp"
                        app:iconTint="@color/on_highlight" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/subjects_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="4dp"
                android:text="@string/study_modules_title"
                android:textAppearance="@style/TextAppearance.Alfred.Section" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <include layout="@layout/view_empty_state" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/add"
        app:srcCompat="@drawable/ic_add" />
</FrameLayout>
