<?xml version="1.0" encoding="utf-8"?>
<!-- Refeição do plano. Fechada: só horário, nome e "feita hoje". Aberta: os alimentos com as
     opções de substituição, a orientação, "O que comi de verdade" e editar/excluir. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho: toque para abrir/fechar -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="10dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/highlight"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Alfred.Title" />
                </LinearLayout>

                <!-- Resumo do que foi comido hoje (quando registrado) -->
                <TextView
                    android:id="@+id/eaten_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Alfred.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Corpo (aberto pelo cabeçalho) -->
        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <!-- Alimentos (preenchido pelo MealAdapter com item_meal_food) -->
            <LinearLayout
                android:id="@+id/items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Orientação da nutricionista para esta refeição -->
            <TextView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Alfred.Caption"
                android:textColor="@color/highlight"
                android:textStyle="italic" />

            <!-- O que foi comido de verdade hoje -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/meal_eaten_title"
                android:textAppearance="@style/TextAppearance.Alfred.Label" />

            <TextView
                android:id="@+id/eaten_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Alfred.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_eaten"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="@string/meal_eaten_add"
                    app:icon="@drawable/ic_edit" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/button_edit"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/meal_edit_plan"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/button_delete"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
