<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Dieta: planilha importada, card de importação (1º acesso), atalhos (água,
     orientações, importar, template), grupos de substituição e as refeições do plano -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/list_bottom_space">

            <TextView
                android:id="@+id/plan_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="2dp"
                android:textAppearance="@style/TextAppearance.Alfred.Caption" />

            <!-- Lendo a planilha escolhida -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/import_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="6dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Enquanto nenhuma planilha foi importada: pede o arquivo e oferece o template -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/import_card"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_glow"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_tile">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_upload"
                                app:tint="@color/highlight" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/diet_import_title"
                            android:textAppearance="@style/TextAppearance.Alfred.Title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/import_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.Alfred.Caption"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/diet_import_button"
                        app:icon="@drawable/ic_upload" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/template_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/diet_template_button"
                        app:icon="@drawable/ic_download" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Atalhos gerais: Água, Orientações, Importar nova planilha, Baixar template -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_padding"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/groups_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="8dp"
                android:text="@string/diet_groups_title"
                android:textAppearance="@style/TextAppearance.Alfred.Section" />

            <!-- Atalhos para os 15 grupos da lista de substituição -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_padding"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <!-- ErrorState: o plano embutido não pôde ser lido -->
            <include
                android:id="@+id/plan_error"
                layout="@layout/view_empty_state" />

            <TextView
                android:id="@+id/meals_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="14dp"
                android:text="@string/diet_meals_title"
                android:textAppearance="@style/TextAppearance.Alfred.Section" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- EmptyState: nenhuma refeição -->
            <include
                android:id="@+id/meals_empty"
                layout="@layout/view_empty_state" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/meal_new"
        app:srcCompat="@drawable/ic_add" />
</FrameLayout>
