<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do resumo do dia: cor da categoria, nome, barra de progresso e contagem -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <View
        android:id="@+id/swatch"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_pill" />

    <TextView
        android:id="@+id/label"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Alfred.Body"
        android:textSize="13sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="100"
        app:trackThickness="4dp"
        app:trackCornerRadius="2dp" />

    <TextView
        android:id="@+id/count"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Alfred.Caption" />
</LinearLayout>
