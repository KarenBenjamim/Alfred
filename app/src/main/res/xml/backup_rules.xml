<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 e anteriores: nada do Alfred entra em backup (o allowBackup já está desligado;
     esta regra cobre o caso de alguém religá-lo). Ver também data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
